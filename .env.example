# =============================================================================
# code-server Docker Environment Configuration
# =============================================================================
# Copy this file to .env and customize the values for your setup.
# Do NOT commit .env to version control as it may contain sensitive data.
# =============================================================================

# -----------------------------------------------------------------------------
# Network Configuration
# -----------------------------------------------------------------------------
# Public hostname. DNS must be a Cloudflare grey-cloud (DNS only) A record pointing at
# this host; Caddy validates over TLS-ALPN-01 on 443 so orange-cloud would break issuance.
# The hostname also needs a route file in ../network/nginx-proxy/conf/routes/ -> jupyter-caddy:443
DOMAIN=jupyter.yuufeng.com
ACME_EMAIL=you@example.com

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# PASSWORD: Password for the code-server login page
# Generate a secure one using: openssl rand -hex 32
PASSWORD=your_secure_password_here

# -----------------------------------------------------------------------------
# File System
# -----------------------------------------------------------------------------
# ROOT_DIR: The folder code-server opens and terminals start in
# This path is inside the container and should match a mounted volume
ROOT_DIR=/jupyter

# -----------------------------------------------------------------------------
# Integrations
# -----------------------------------------------------------------------------
# HUGGINGFACE_HUB_TOKEN: Optional; enables authenticated downloads/push to the Hugging Face Hub
# Leave blank to operate unauthenticated.
HUGGINGFACE_HUB_TOKEN=
