# =============================================================================
# JupyterLab Docker Environment Configuration
# =============================================================================
# Copy this file to .env and customize the values for your setup.
# Do NOT commit .env to version control as it may contain sensitive data.
# =============================================================================

# -----------------------------------------------------------------------------
# Network Configuration
# -----------------------------------------------------------------------------
# HOST_PORT: The port exposed on your host machine to access JupyterLab
# CONTAINER_PORT: The port JupyterLab listens on inside the container (default: 8888)
HOST_PORT=8571
CONTAINER_PORT=8888

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# JUPYTER_TOKEN: Secret token required to access JupyterLab
# Generate a secure token using: openssl rand -hex 32
JUPYTER_TOKEN=your_secure_token_here

# -----------------------------------------------------------------------------
# File System
# -----------------------------------------------------------------------------
# ROOT_DIR: The root directory displayed in JupyterLab's file browser
# This path is inside the container and should match a mounted volume
ROOT_DIR=/jupyter
