# TLS termination and reverse proxy for code-server. DOMAIN and ACME_EMAIL come from .env.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	# nginx-proxy only forwards 443, so HTTP-01 is impossible; TLS-ALPN-01 rides the
	# same connection the site is served on. Requires the DNS record to be grey-cloud.
	tls {
		issuer acme {
			email {$ACME_EMAIL}
			disable_http_challenge
		}
	}

	# Security headers (README § Security headers). Each line sets its header only when
	# code-server's response lacks it, so the workbench keeps its own Content-Security-Policy.
	# One directive per header: inside a single header block, `?` defaults apply only when
	# every field of the block is missing. Framing is limited to this origin, not refused:
	# webviews (notebook outputs, previews) and the extension host run in same-origin iframes.
	header ?Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header ?Content-Security-Policy "frame-ancestors 'self'"
	header ?X-Frame-Options SAMEORIGIN
	header ?X-Content-Type-Options nosniff
	header ?Referrer-Policy strict-origin-when-cross-origin
	header ?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

	# WebSockets (editor, terminal, kernels) are proxied transparently.
	reverse_proxy code-server:8080

	log {
		output stdout
	}
}
