# =============================================================================
# code-server with CUDA 12.6 Support
# =============================================================================
# Base image: Astral's uv package manager on Debian Bookworm (slim)
# This provides fast Python dependency management with uv
# =============================================================================
FROM ghcr.io/astral-sh/uv:bookworm-slim

# -----------------------------------------------------------------------------
# System Dependencies
# -----------------------------------------------------------------------------
# Install OS packages commonly needed for ML/audio processing:
#   - vim: Text editor for quick file edits
#   - git: Version control for cloning repositories
#   - wget: Download files from the web
#   - p7zip-full: Archive extraction (7z, zip, etc.)
#   - ffmpeg: Audio/video processing (required by torchaudio)
#   - libsndfile1: Audio file I/O library (required by torchaudio)
#   - unzip: Extract zip archives
#   - zsh: Interactive shell used by the code-server terminal
#   - locales: Provides en_US.UTF-8, required for Powerlevel10k glyphs
RUN apt-get update && apt-get install -y --no-install-recommends \
    vim git wget p7zip-full ffmpeg libsndfile1 unzip curl zsh locales

# Install CA certificates for HTTPS connections
RUN apt-get update && apt-get install -y ca-certificates

# -----------------------------------------------------------------------------
# Locale
# -----------------------------------------------------------------------------
# Powerlevel10k falls back to ASCII icons unless the locale codeset is UTF-8
RUN sed -i 's/^# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
    && locale-gen
ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

# -----------------------------------------------------------------------------
# Shell Environment (zsh + oh-my-zsh + Powerlevel10k)
# -----------------------------------------------------------------------------
# code-server's integrated terminal launches $SHELL. Everything below prepares
# that shell.
ENV ZSH=/root/.oh-my-zsh \
    ZSH_CUSTOM=/root/.oh-my-zsh/custom \
    SHELL=/bin/zsh \
    GITSTATUS_CACHE_DIR=/opt/gitstatus

RUN git clone --depth=1 https://github.com/ohmyzsh/ohmyzsh.git "$ZSH" \
    && git clone --depth=1 https://github.com/zsh-users/zsh-autosuggestions.git \
        "$ZSH_CUSTOM/plugins/zsh-autosuggestions" \
    && git clone --depth=1 https://github.com/zsh-users/zsh-syntax-highlighting.git \
        "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting" \
    && git clone --depth=1 https://github.com/zsh-users/zsh-completions.git \
        "$ZSH_CUSTOM/plugins/zsh-completions" \
    && git clone --depth=1 https://github.com/romkatv/powerlevel10k.git \
        "$ZSH_CUSTOM/themes/powerlevel10k"

# Pre-download the gitstatusd daemon at build time so the first prompt is fast.
# It must NOT live under /root/.cache (its default): that path is a bind mount
# at runtime and would hide anything baked into the image.
RUN "$ZSH_CUSTOM/themes/powerlevel10k/gitstatus/install" \
    && ls -l /opt/gitstatus

# Prompt configuration, copied from the host's ~/.p10k.zsh
COPY p10k.zsh /root/.p10k.zsh
COPY zshrc /root/.zshrc

# -----------------------------------------------------------------------------
# Python Environment Setup
# -----------------------------------------------------------------------------
WORKDIR /app

# Copy dependency files first to leverage Docker layer caching
# Changes to source code won't invalidate the dependency layer
COPY pyproject.toml uv.lock ./

# Keep the uv-managed interpreter out of /root: the home directory is a persistent
# volume at runtime (see docker-compose.yml), and /app/.venv links to the interpreter
# by path, so a stale copy in the volume would break the venv after an image update.
ENV UV_PYTHON_INSTALL_DIR=/opt/uv/python \
    UV_LINK_MODE=copy

# Install Python dependencies using uv
#   --frozen: Use exact versions from uv.lock (reproducible builds)
#   --no-dev: Skip development dependencies (smaller image)
# The cache mount keeps downloaded wheels across builds, so changing a dependency
# does not re-download torch/tensorflow.
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev

# Verify the kernel the Jupyter extension will launch
RUN /app/.venv/bin/python -m ipykernel --version

# -----------------------------------------------------------------------------
# code-server
# -----------------------------------------------------------------------------
# Installed after the Python layer so a version bump does not invalidate the
# multi-GB dependency layer above.
ARG CODE_SERVER_VERSION=4.138.0
RUN curl -fsSL -o /tmp/code-server.deb \
        "https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/code-server_${CODE_SERVER_VERSION}_amd64.deb" \
    && dpkg -i /tmp/code-server.deb \
    && rm /tmp/code-server.deb

# Default extensions, installed from Open VSX. The directory is a named volume at
# runtime (see docker-compose.yml): Docker seeds it from the image on first
# creation only, after which extensions are installed/updated from the UI and
# persist in the volume. The same applies to everything under /root (zsh config,
# code-server settings, ...): the image only provides the initial contents.
#   - ms-toolsai.jupyter / ms-python.python: notebooks, kernels from /app/.venv
#   - astral-sh.ty: language server (completion, go-to-definition, type checking)
#   - charliermarsh.ruff: lint + format
#   - vscode-language-pack-zh-hant: Traditional Chinese UI
#   - anthropic.claude-code: Claude Code
ENV CODE_SERVER_EXTENSIONS_DIR=/opt/code-server/extensions
RUN for ext in \
        ms-python.python \
        ms-toolsai.jupyter \
        astral-sh.ty \
        charliermarsh.ruff \
        MS-CEINTL.vscode-language-pack-zh-hant \
        Anthropic.claude-code; \
    do code-server --extensions-dir "$CODE_SERVER_EXTENSIONS_DIR" --install-extension "$ext" || exit 1; done

# Default user settings; part of the /root volume, so seeded on first creation only.
COPY code-server/settings.json /root/.local/share/code-server/User/settings.json
