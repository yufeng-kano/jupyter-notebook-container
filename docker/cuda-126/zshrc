# =============================================================================
# zsh configuration for the JupyterLab terminal
# =============================================================================

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export ZSH=$HOME/.oh-my-zsh
ZSH_THEME="powerlevel10k/powerlevel10k"

# gitstatusd is baked into the image here; /root/.cache is a bind mount at
# runtime, so the daemon must not be looked up under its default location.
export GITSTATUS_CACHE_DIR=/opt/gitstatus

fpath+=${ZSH_CUSTOM:-$ZSH/custom}/plugins/zsh-completions/src
plugins=(
	git
	sudo
	zsh-completions
	zsh-autosuggestions
	zsh-syntax-highlighting
)

source $ZSH/oh-my-zsh.sh

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# -----------------------------------------------------------------------------
# Project environment
# -----------------------------------------------------------------------------
# Activate the uv-managed virtualenv so python/pip resolve to the same
# interpreter JupyterLab's kernels use.
[[ ! -f /app/.venv/bin/activate ]] || source /app/.venv/bin/activate

alias dfh='df -h -x tmpfs -x devtmpfs'
